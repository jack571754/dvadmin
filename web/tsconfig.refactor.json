{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "/@/*": ["src/*"]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/app/**/*.ts",
    "src/types/**/*.d.ts",
    "src/shared/**/*.ts",
    "src/features/**/*.ts",
    "src/features/**/*.vue",
    "src/shared/**/*.vue",
    "src/views/system/user/index.vue",
    "src/views/system/user/crud.tsx",
    "src/views/system/user/context.ts",
    "src/views/system/role/index.vue",
    "src/views/system/role/crud.tsx",
    "src/views/system/role/context.ts"
  ]
}
