{
	"name": "django-vue3-admin",
	"version": "3.2.0",
	"description": "是一套全部开源的快速开发平台，毫无保留给个人免费使用、团体授权使用。\n    django-vue3-admin 基于RBAC模型的权限控制的一整套基础开发平台，权限粒度达到列级别，前后端分离，后端采用django + django-rest-framework，前端采用基于 vue3 + CompositionAPI + typescript + vite + element plus",
	"license": "MIT",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite --force",
		"build:dev": "vite build --mode development",
		"build": "vite build",
		"build:local": "vite build --mode local_prod",
		"lint-fix": "pnpm lint:fix",
		"build:flowH5": "vite build --config flowH5.config.ts",
		"lint": "node scripts/check-lint.mjs",
		"lint:all": "eslint src tests playwright.config.ts",
		"lint:fix": "eslint src tests playwright.config.ts --fix",
		"typecheck": "vue-tsc --noEmit -p tsconfig.refactor.json",
		"typecheck:legacy": "vue-tsc --noEmit -p tsconfig.json",
		"test:unit": "node --test scripts/tests/*.test.mjs tests/product-spec-*.test.mjs",
		"test:e2e": "playwright test --project=smoke",
		"test:parity": "playwright test --project=parity",
		"test:i18n": "playwright test --project=i18n",
		"test:prepare": "python ../backend/scripts/prepare_e2e.py",
		"baseline": "node scripts/capture-baseline.mjs"
	},
